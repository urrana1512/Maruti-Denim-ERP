PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/maruti_denim
CLIENT_URL=http://localhost:5173
JWT_SECRET=maruti_denim_jwt_secret_key_change_in_production
OTP_SECRET=maruti_denim_otp_hmac_secret_key_2026

# =========================================================================
# EMAIL DELIVERY CONFIGURATION
# =========================================================================
# Email provider choice: smtp | sendgrid | ses | postmark | resend
EMAIL_PROVIDER=smtp

# Application Sender Identity (shown to users in the 'From' field)
EMAIL_FROM="Maruti Denim System <company-email@gmail.com>"

# --- Option 1: Gmail SMTP Setup (Dedicated Application Account) ---
# Requires 2-Step Verification + Google App Password generated on the Gmail account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-company-email@gmail.com
SMTP_PASS=your-16-character-app-password

# --- Option 2: Transactional Provider (SendGrid / Postmark / Resend / SES) ---
# Set EMAIL_PROVIDER=sendgrid (or postmark/resend/ses) and supply your API Key:
# EMAIL_API_KEY=your_transactional_provider_api_key
